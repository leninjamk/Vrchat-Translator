# ─── Ambiente virtual (gerado pelo Install.bat em cada máquina) ───────────────
.venv/
venv/
env/

# ─── Configurações pessoais (dispositivos de áudio de cada usuário) ───────────
settings.json

# ─── Cache Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ─── Arquivos temporários de audio ────────────────────────────────────────────
*.mp3
*.wav

# ─── IDEs / Editores ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ─── Claude Code (config/sessão local) ─────────────────────────────────────────
.claude/

# ─── Build do componente nativo (native/app_loopback_capture) ─────────────────
# O .exe compilado em bin/ FICA versionado de proposito (nao ha passo de build
# no instalador) — so os artefatos intermediarios de compilacao sao ignorados.
*.obj
*.pdb
*.ilk
native/**/build/

# ─── Sistema Operacional ──────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini
